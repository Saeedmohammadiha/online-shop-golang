{
  "version": "0.2.0",
  "configurations": [
      {
        "debugAdapter": "dlv-dap",
          "name": "Docker: Attach to Go",
          "type": "go",
          "request": "attach",
          "mode": "remote",
          "remotePath": "/app",
          "port": 40000,
         
          "showLog": true,
          "substitutePath": [
      { "from": "${workspaceFolder}", "to": "/app" },
  ]
      }
  ]
}
